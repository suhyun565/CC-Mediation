# Copy to `.env` at the repo root and fill in your keys.
# The pipeline reads keys via python-dotenv.

# OpenRouter — used for dialogue generation, LLM-judge scoring, and the
# logprob-based DMIS labeler (metrics/llm_stage_judge.py). Sign up at
# https://openrouter.ai/ and paste the sk-or-... key here.
OPENROUTER_API_KEY=sk-or-...

# HuggingFace token — required if you use the local logprob labeler
# (metrics/llm_stage_judge_local.py) with a gated model (e.g., Llama-3).
HF_TOKEN=hf_...
